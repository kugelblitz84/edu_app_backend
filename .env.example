NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL="postgresql://postgres:6226@localhost:5432/edu_app_sadi?schema=public"
MONGODB_URL="mongodb://localhost:27017/edu_app_sadi"
# Required when Socket.IO events must cross application instances.
# REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=edu-app-api
EXAM_INVITATION_TOKEN_SECRET=replace-with-another-32-character-random-secret
EXAM_INVITATION_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_URL=https://app.example.com/reset-password
PASSWORD_RESET_TTL_SECONDS=3600
IP_REGION_HEADER=cf-ipcountry
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=your-account@gmail.com
SCRYPT_KEY_LENGTH=64
SCRYPT_COST=131072
SCRYPT_BLOCK_SIZE=8
SCRYPT_PARALLELIZATION=1

# Required when a feature imports StorageModule.
CLOUDINARY_CLOUD_NAME=******************
CLOUDINARY_API_KEY=******************
CLOUDINARY_API_SECRET=**********************

# Signed preset for formats; size policy is checked at completion (see src/core/storage/README.md).
CLOUDINARY_UPLOAD_PRESET=edu-storage-restricted
CLOUDINARY_MAX_UPLOAD_BYTES=10485760

# Study materials: byte limits are also constrained by CLOUDINARY_MAX_UPLOAD_BYTES.
MATERIAL_PDF_MAX_BYTES=10485760
MATERIAL_VIDEO_MAX_BYTES=10485760
MATERIAL_IMAGE_MAX_BYTES=5242880
MATERIAL_COLLECTION_MAX_ITEMS=500
MATERIAL_RESOURCE_MAX_COLLECTIONS=100
MATERIAL_PENDING_MAX=10
MATERIAL_UPLOADS_PER_HOUR=30
MATERIAL_PIN_TARGET_ATTEMPTS=5
MATERIAL_PIN_IP_ATTEMPTS=30
MATERIAL_CLEANUP_GRACE_SECONDS=3600
MATERIAL_CLEANUP_POLL_MS=30000
MATERIAL_CLEANUP_BATCH=20

# SSLCommerz payment gateway (leave IS_LIVE=false for sandbox)
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_LIVE=false
# Public HTTPS URLs. Set PAYMENT_IPN_URL to https://<api-host>/api/v1/payments/ipn
PAYMENT_SUCCESS_URL=https://app.example.com/payment/success
PAYMENT_FAILURE_URL=https://app.example.com/payment/failure
PAYMENT_CANCELLED_URL=https://app.example.com/payment/cancelled
PAYMENT_IPN_URL=https://api.example.com/api/v1/payments/ipn
