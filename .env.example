NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL="postgresql://postgres:6226@localhost:5432/edu_app_sadi?schema=public"
MONGODB_URL="mongodb://localhost:27017/edu_app_sadi"
# Required when Socket.IO events must cross application instances.
# REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=edu-app-api
EXAM_INVITATION_TOKEN_SECRET=replace-with-another-32-character-random-secret
EXAM_INVITATION_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_URL=https://app.example.com/reset-password
PASSWORD_RESET_TTL_SECONDS=3600
IP_REGION_HEADER=cf-ipcountry
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=your-account@gmail.com
SCRYPT_KEY_LENGTH=64
SCRYPT_COST=131072
SCRYPT_BLOCK_SIZE=8
SCRYPT_PARALLELIZATION=1
