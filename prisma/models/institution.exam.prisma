// ExamStatus is shared with PersonalExam and is defined in
// personal.exam.prisma.

model InstitutionExam {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId   String         @map("institution_id") @db.Uuid
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name            String         @db.VarChar(200)
  description     String?        @db.VarChar(1000)
  startsAt        DateTime?      @map("starts_at") @db.Timestamptz
  closesAt        DateTime?      @map("closes_at") @db.Timestamptz
  durationMinutes Int?           @map("duration_minutes")
  maxAttempts     Int            @default(1) @map("max_attempts")
  passPercentage  Decimal?       @map("pass_percentage") @db.Decimal(5, 2)
  contentVersion  Int            @default(0) @map("content_version")
  status          ExamStatus     @default(DRAFT)
  accessMode      ExamAccessMode @default(OPEN) @map("access_mode")
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdByUser   User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz

  @@index([institutionId])
  @@index([createdByUserId])
  @@index([startsAt])
  @@index([closesAt])
  @@index([status])
  @@index([createdAt])
  @@map("institution_exams")
}
