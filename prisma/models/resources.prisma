enum ResourceType {
  PDF
  VIDEO
  ARTICLE

  @@map("resource_type")
}

enum ResourceAccessPolicy {
  FREE
  OWNER_ONLY
  ENROLLED
  PURCHASE
  SUBSCRIPTION

  @@map("resource_access_policy")
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED

  @@map("resource_status")
}

model Resource {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             ResourceType
  title            String               @db.VarChar(200)
  description      String               @db.Text
  ownerUserId      String?              @map("owner_user_id") @db.Uuid
  ownerUser       User?                @relation("ResourceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  institutionId    String?              @map("institution_id") @db.Uuid
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  accessPolicy     ResourceAccessPolicy @map("access_policy")
  status           ResourceStatus       @default(DRAFT)
  metadata         Json?                @db.JsonB
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz

  @@map("resources")
}
